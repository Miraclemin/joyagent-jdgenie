spring:
  application:
    name: genie-backend
  config:
    encoding: UTF-8
server:
  port: 8080
logging:
  level:
    root: INFO
genie:
  auth:
    # API鉴权Token，如果配置了token，则所有API请求都需要在请求头中携带X-Auth-Token
    # 如果为空，则不进行token鉴权
    token: 'YOUR_TOKEN_HERE'
llm:
  default:
    base_url: 'YOUR_API_BASE_URL'
    apikey: 'YOUR_API_KEY'
    interface_url: '/chat/completions'
    model: gpt-4.1
    max_tokens: 16384
  settings: '{"claude-3-7-sonnet-v1": {
        "model": "claude-3-7-sonnet-v1",
        "max_tokens": 8192,
        "temperature": 0,
        "base_url": "YOUR_API_BASE_URL",
        "apikey": "YOUR_API_KEY",
        "interface_url": "/chat/completions",
        "max_input_tokens": 128000
    }}'

# 其他配置保持不变，请参考原始配置文件...

